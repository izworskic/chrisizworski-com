# Server-only key used by /api/field-camera for selected Windy webcams.
WINDY_WEBCAMS_API_KEY=

# Server-only key used by /api/kilauea-live to verify current NPS closure/alert state.
NPS_API_KEY=

# 511NY: server-only Vercel secrets; do not commit actual credentials.
NY511_USERNAME=
NY511_PASSWORD=
# Shared Upstash Redis is required for the distributed 5-minute refresh lock.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Cron authenticates /api/nyc-511?action=cron using this secret.
CRON_SECRET=
