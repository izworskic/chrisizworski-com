{
  "version": "1.2.0",
  "updated": "2026-08-31",
  "objective": "Ship a separate U.S. outdoor decision network without weakening Michigan canonicals, source truth, or search quality.",
  "lossFunction": {
    "factualDataIntegrity": 25,
    "michiganCannibalizationExperimentProtection": 20,
    "decisionUsefulness": 15,
    "freshnessFailureTransparency": 10,
    "sourceLicensingIntegrity": 10,
    "searchDistinctValue": 10,
    "performanceAccessibility": 5,
    "sharedPlatformMaintainability": 5,
    "total": 100
  },
  "hardVetoes": [
    "no-fake-live-values",
    "no-river-safety-score",
    "no-kp-as-local-probability",
    "no-hardiness-as-frost-date",
    "no-fake-foliage-precision",
    "no-doorway-location-pages",
    "no-michigan-canonical-clones",
    "no-silent-stale-defaults"
  ],
  "phase1": [
    {
      "id": "national-aurora",
      "route": "/national-tools/aurora/",
      "api": "/api/national-aurora",
      "status": "live"
    },
    {
      "id": "national-rivers",
      "route": "/national-tools/rivers/",
      "api": "/api/national-rivers",
      "status": "live"
    },
    {
      "id": "national-frost",
      "route": "/national-tools/frost/",
      "api": "/api/national-frost",
      "status": "live"
    },
    {
      "id": "national-planting",
      "route": "/national-tools/planting/",
      "api": "/api/national-frost",
      "status": "live"
    },
    {
      "id": "national-fall-color",
      "route": "/national-tools/fall-color/",
      "api": "/api/national-fall-color",
      "status": "calibration-beta"
    }
  ],
  "indexPolicy": {
    "hub": true,
    "phase1EntryPages": true,
    "generatedLocationPages": false,
    "zipCropDatePages": false,
    "phase2AddsIndexableRoutes": false,
    "phase3AddsIndexableRoutes": false
  },
  "protectedMichiganRoutes": [
    "/tools/",
    "/northern-lights-michigan/",
    "/fall-color/",
    "/michigan-frost-dates/",
    "/zone-6a-planting-calendar/"
  ],
  "phase2": {
    "principle": "Deepen decision usefulness and source transparency before expanding URL count.",
    "capabilities": [
      "shared-source-freshness-contract",
      "location-timezone-context",
      "aurora-best-dark-weather-window-and-moon-context",
      "river-same-date-usgs-percentiles",
      "river-exact-usgs-to-nwps-official-forecast-match",
      "frost-spring-and-fall-probabilities",
      "frost-hard-freeze-and-station-confidence",
      "extension-sourced-20-crop-planting-rules",
      "fall-color-historical-timing-band-plus-separate-current-weather"
    ],
    "smokeAirQuality": {
      "status": "source-key-gated",
      "reason": "AirNow developer access and NASA FIRMS MAP_KEY are required for the intended authoritative implementation. Do not ship a weaker fake-live substitute.",
      "requiredConfiguration": [
        "AIRNOW_API_KEY",
        "FIRMS_MAP_KEY"
      ],
      "indexableRouteCreated": false
    }
  },
  "phase3": {
    "principle": "Make the five tools behave like one decision platform before adding another product family or location-page surface.",
    "capabilities": [
      "live-multi-signal-outdoor-desk",
      "decision-urgency-ordering-without-universal-safety-score",
      "independent-feed-degradation",
      "saved-place-local-device-state",
      "cross-tool-location-continuity",
      "searched-location-timezone-rendering",
      "keyless-fail-soft-river-spatial-context",
      "location-page-admission-gate"
    ],
    "alerts": {
      "status": "deferred-until-real-delivery-channel",
      "rule": "Do not label saved places, local state, or passive UI as alerts. Ship alerts only when the system can actually deliver a future notification and preserve source/freshness semantics."
    },
    "measurement": {
      "status": "use-existing-search-and-product-measurement-before-location-expansion",
      "rule": "Do not create a new tracking endpoint merely to manufacture telemetry. Location-page admission requires real query/impression or documented user-demand evidence."
    },
    "locationAdmissionContract": "benchmarks/national-location-admission.json"
  }
}
