{
  "version": "1.2.0",
  "updated": "2026-08-29",
  "id": "tc-wine-map-growth",
  "property": "https://tcwine.chrisizworski.com/",
  "canonicalPerson": "https://chrisizworski.com/#person",
  "objective": "Earn large-scale non-branded Traverse City winery-map discovery while strengthening truthful Chris Izworski authorship and preserving one canonical owner per intent.",
  "northStar": {
    "dailyImpressions": 1000,
    "dailyClicks": 100,
    "status": "aspirational-not-guaranteed"
  },
  "treatment": {
    "start": "2026-08-29",
    "minimumWindowDays": 28,
    "freeze": [
      "canonical",
      "title",
      "h1",
      "core meta description",
      "winery counts",
      "primary schema identity",
      "indexability"
    ]
  },
  "canonicalFamilies": [
    "traverse-city-winery-map",
    "old-mission-winery-map",
    "leelanau-winery-map",
    "old-mission-vs-leelanau",
    "wineries-with-food",
    "wineries-with-views",
    "fall-color-winery-map",
    "tasting-room-hours"
  ],
  "truth": {
    "totalWineries": 40,
    "oldMissionWineries": 11,
    "leelanauWineries": 27,
    "traverseCityOtherWineries": 2,
    "scope": "search-treatment-baseline",
    "note": "The active map-first search treatment launched on the earlier 40-location dataset and its search-facing count is protected during the measurement window."
  },
  "expansionGate": {
    "queryFamilyImpressions": 250,
    "clicks": 5,
    "mapLoads": 10,
    "routeBuilds": 3,
    "requiresCannibalizationCheck": true
  },
  "privacy": {
    "forbiddenAnalytics": [
      "free-text search",
      "precise user location",
      "selected venue ids",
      "selected venue names",
      "exact plan url or hash",
      "trip date or exact time",
      "personal identifiers"
    ]
  },
  "continuity": {
    "layer": "my-wine-day",
    "purpose": "increase route commitment, return use, and group sharing without changing the active search treatment",
    "localOnly": true,
    "indexableUserPlanPages": false,
    "shareTransport": "url-fragment",
    "events": [
      "wine_plan_saved",
      "wine_plan_removed",
      "wine_plan_resumed",
      "wine_plan_shared",
      "wine_summary_copied"
    ],
    "initialTargets": {
      "routeBuildToSaveRate": 0.08,
      "routeBuildToShareRate": 0.05,
      "resumedOrSharedPlanRebuildRate": 0.2,
      "allowMapLoadRegression": false,
      "allowRouteBuildRegression": false
    }
  },
  "directoryTruth": {
    "mappedWineryTastingRoomLocations": 43,
    "oldMission": 11,
    "leelanau": 30,
    "traverseCity": 2,
    "scope": "current-production-directory",
    "note": "Geographic directory inclusion is distinct from official wine-trail association membership."
  },
  "authorityFlywheel": {
    "diagnosis": "BUILD_AUTHORITY",
    "publisherKit": "/for-publishers",
    "embed": "/embed/traverse-city-winery-map",
    "indexablePublisherSurfaces": false,
    "recommendedAttribution": "Chris Izworski's Traverse City Winery Map",
    "events": [
      "wine_embed_loaded",
      "wine_embed_planner_opened",
      "wine_publisher_embed_copied",
      "wine_publisher_data_opened"
    ],
    "targets30d": {
      "newReferringDomains": 5,
      "livePublisherEmbeds": 2,
      "qualifiedReferralSessions": 100,
      "referralRouteBuilds": 20,
      "externalChrisIzworskiCitations": 1
    },
    "prohibited": [
      "paid links",
      "scaled reciprocal link exchanges",
      "low-quality directory blasts"
    ]
  }
}
