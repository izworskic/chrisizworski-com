    ["kayak", "kayaking", "canoe", "canoeing", "paddle", "paddling"],
    ["freighter", "ship", "vessel", "laker"],
    ["hike", "hiking", "trek"],
    ["waterfowl", "duck", "goose", "geese"],
    ["firefly", "lightningbug"],
    ["mortgage", "house", "home"],
    ["flight", "plane", "airplane", "airline"],
    ["beach", "swim", "swimming"],
    ["bloom", "blossom", "flower", "wildflower"],
    ["pest", "insect", "bug"],
    ["freeze", "frost"],
    ["rockhound", "rockhounding", "agate", "geode"],
    ["syrup", "sap", "sugaring", "sugarhouse"],
    ["wine", "winery", "vineyard"],
    ["color", "colour"],
