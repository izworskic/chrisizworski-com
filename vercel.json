{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/border-crossings.js": {
      "maxDuration": 20
    },
    "api/border-media.js": {
      "maxDuration": 20
    },
    "api/border-trends.js": {
      "maxDuration": 20
    },
    "api/mackinac-media.js": {
      "maxDuration": 20
    },
    "api/beaches.js": {
      "maxDuration": 25
    },
    "api/fall-color-conditions.js": {
      "maxDuration": 30
    },
    "api/fall-color-report.js": {
      "maxDuration": 15
    },
    "api/fall-color-cron-report.js": {
      "maxDuration": 60
    },
    "api/fall-color-sitemap.js": {
      "maxDuration": 10
    },
    "api/fall-color-rss.js": {
      "maxDuration": 15
    },
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/chris-izworski-bay-city-michigan",
      "destination": "/chris-izworski-bay-city/",
      "permanent": true
    },
    {
      "source": "/chris-izworski-bay-city-michigan/",
      "destination": "/chris-izworski-bay-city/",
      "permanent": true
    },
    {
      "source": "/chris-izworski-speaking",
      "destination": "/speaking/",
      "permanent": true
    },
    {
      "source": "/chris-izworski-speaking/",
      "destination": "/speaking/",
      "permanent": true
    },
    {
      "source": "/news-coverage",
      "destination": "/chris-izworski-news-coverage/",
      "permanent": true
    },
    {
      "source": "/news-coverage/",
      "destination": "/chris-izworski-news-coverage/",
      "permanent": true
    },
    {
      "source": "/prepared",
      "destination": "/chris-izworski-prepared/",
      "permanent": true
    },
    {
      "source": "/prepared/",
      "destination": "/chris-izworski-prepared/",
      "permanent": true
    },
    {
      "source": "/save-our-shoreline",
      "destination": "/chris-izworski-save-our-shoreline/",
      "permanent": true
    },
    {
      "source": "/save-our-shoreline/",
      "destination": "/chris-izworski-save-our-shoreline/",
      "permanent": true
    },
    {
      "source": "/fall-color/western-upper-peninsula-fall-color",
      "destination": "/fall-color/porcupine-mountains-fall-color",
      "permanent": true
    },
    {
      "source": "/fall-color/eastern-upper-peninsula-fall-color",
      "destination": "/fall-color/tahquamenon-falls-fall-color",
      "permanent": true
    },
    {
      "source": "/fall-color/sleeping-bear-fall-color",
      "destination": "/fall-color/sleeping-bear-dunes-fall-color",
      "permanent": true
    },
    {
      "source": "/fall-color/southwest-michigan-fall-color",
      "destination": "/fall-color/saugatuck-southwest-michigan-fall-color",
      "permanent": true
    },
    {
      "source": "/fall-color/southeast-michigan-fall-color",
      "destination": "/fall-color/ann-arbor-irish-hills-fall-color",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<preview>.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/fall-color-cron-report",
      "schedule": "0 11 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/fall-color/rss.xml",
      "destination": "/api/fall-color-rss"
    },
    {
      "source": "/fall-color/sitemap.xml",
      "destination": "/api/fall-color-sitemap"
    }
  ]
}
